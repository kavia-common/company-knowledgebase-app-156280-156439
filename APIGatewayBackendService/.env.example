# Application
APP_NAME=Knowledgebase Backend API
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ALLOW_ORIGINS=*

# Security
SECRET_KEY=replace_with_secure_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=43200
PASSWORD_MIN_LENGTH=12
ENABLE_MFA=true
JWT_ALGORITHM=HS256

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/knowledgebase

# External Services (placeholders for future integration)
LDAP_URL=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
SSO_OIDC_ISSUER=
SSO_OIDC_CLIENT_ID=
SSO_OIDC_CLIENT_SECRET=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
SEARCH_INDEX_ENDPOINT=
AI_QA_ENDPOINT=
SIEM_ENDPOINT=

# File Storage
STORAGE_ROOT=./storage
MAX_UPLOAD_SIZE_MB=1024

# Compliance/Audit
AUDIT_HASH_CHAIN_SALT=replace_with_random_salt
LOG_RETENTION_DAYS=365
